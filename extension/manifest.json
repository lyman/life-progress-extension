{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.4",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": ["storage", "search"],
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "人生进度",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "__MSG_cmdOpenPopup__"
    }
  }
}
